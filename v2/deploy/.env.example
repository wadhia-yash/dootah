# Copy outside the checkout, e.g. /srv/dootah/operator/deploy.env.
COMPOSE_PROJECT_NAME=dootah
DOOTAH_SITE=updates.example.com
DOOTAH_CLOUD_ORIGIN=https://updates.example.com
DOOTAH_OPERATOR_EMAIL=operator@example.com
DOOTAH_SECRETS_DIR=/srv/dootah/operator/secrets
DOOTAH_CADDYFILE=/srv/dootah/repo/v2/deploy/Caddyfile
DOOTAH_BIND_IP=0.0.0.0
DOOTAH_HTTP_PORT=80
DOOTAH_HTTPS_PORT=443
