# ALPHA / CLEAN-ROOM VALIDATION USING NGROK
# Public HTTPS terminates at ngrok. Only host-loopback port 18080 reaches :80.
{
 admin off
 auto_https off
 servers {
  timeouts {
   read_header 10s
   read_body 30s
   write 120s
   idle 60s
  }
  max_header_size 32KB
 }
}
:80 {
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  -Server
 }
 request_body {
  max_size 128KB
 }
 reverse_proxy cloud:3100 {
  # Cloud trusts only this proxy-set value for per-client rate limits. Without
  # trusted_proxies, client_ip is the TCP peer; client-sent X-Forwarded-For is replaced.
  header_up X-Forwarded-For {client_ip}
  transport http {
   dial_timeout 5s
   response_header_timeout 30s
  }
 }
}
